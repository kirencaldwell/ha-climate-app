<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily: pull the logs and ML rows from the Home Assistant Green and train the ML correction here (tools/ml_train_local.py).
     Runs from the clone outside ~/Documents (macOS blocks launchd jobs there). At 04:15, after the Green's 03:40 physics fit
     and 03:58 ML training; a run missed while the Mac sleeps happens when it wakes. Install:
       cp tools/com.roomclimate.mltrain.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.roomclimate.mltrain.plist
     Stop: launchctl unload ~/Library/LaunchAgents/com.roomclimate.mltrain.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.roomclimate.mltrain</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kirencaldwell/.local/share/room-climate-watch/analysis-venv/bin/python</string>
    <string>/Users/kirencaldwell/.local/share/room-climate-watch/repo/tools/ml_train_local.py</string>
    <string>--sync</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/kirencaldwell/.local/share/room-climate-watch/repo</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/Users/kirencaldwell/.local/state/room-climate-watch/ml.log</string>
  <key>StandardErrorPath</key><string>/Users/kirencaldwell/.local/state/room-climate-watch/ml.log</string>
</dict>
</plist>
